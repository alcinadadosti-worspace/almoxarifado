# ============================================================================
# ACQUA Almoxarifado — variáveis do frontend (Vite)
# Copie para `web/.env`. Sem as chaves do Firebase a aplicação usa o login de
# desenvolvimento exposto pela API (ALLOW_DEV_AUTH=true no backend).
# ============================================================================

# Base da API. Em desenvolvimento fica vazio: o Vite faz proxy de /api.
VITE_API_URL=

# Firebase Auth (painel do admin) — Console > Configurações do projeto > Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
