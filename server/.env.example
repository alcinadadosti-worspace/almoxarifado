# ============================================================================
# ACQUA Almoxarifado — variáveis de ambiente do backend
# Copie para `server/.env` e preencha. Nada aqui é obrigatório para rodar em
# modo de desenvolvimento (driver local); tudo é obrigatório em produção.
# ============================================================================

# ---------------------------------------------------------------- Aplicação
PORT=4000
NODE_ENV=development

# URL pública do frontend — usada para montar o link de aceite enviado ao
# colaborador (https://SEU-DOMINIO/aceite/<token>).
APP_BASE_URL=http://localhost:5173

# Origens permitidas no CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------- Firebase
# Driver de dados: auto (usa Firestore se houver credencial) | firestore | local
DATA_DRIVER=auto

FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com

# Escolha UMA das formas de credencial do Admin SDK:
#  1) caminho para o JSON da conta de serviço
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
#  2) o JSON inteiro (ou o JSON em base64) numa única variável — ideal p/ deploy
FIREBASE_SERVICE_ACCOUNT=
#  3) Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS / GCP)

# Emuladores (opcional, para desenvolvimento local com o Firebase Emulator Suite)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# -------------------------------------------------------------------- Acesso
# Lista de e-mails autorizados a usar o painel (vazio = qualquer conta do Auth).
ADMIN_EMAILS=

# Login de desenvolvimento sem Firebase Auth (NUNCA use em produção).
ALLOW_DEV_AUTH=true
DEV_ADMIN_EMAIL=logisticavdpenedo@cpalcina.com
DEV_ADMIN_PASSWORD=almoxarifado

# --------------------------------------------------------------------- Slack
# Sem estas variáveis a aplicação funciona 100%: o admin copia o link manualmente.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Canal que recebe avisos de assinatura e de estoque baixo (ex.: C0123456789)
SLACK_ADMIN_CHANNEL=

# ------------------------------------------------------------------ Segurança
# Segredo para assinar URLs de arquivos no driver local (gere um valor aleatório).
FILE_SIGNING_SECRET=troque-este-segredo-em-producao

# Validade do link de aceite (horas) e da URL assinada de download (minutos).
ACCEPT_TOKEN_TTL_HOURS=168
SIGNED_URL_TTL_MINUTES=15

# Estoque abaixo deste valor dispara alerta no painel e no Slack.
LOW_STOCK_THRESHOLD=5
